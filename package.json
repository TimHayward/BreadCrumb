{
  "name": "breadcrumb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Microsoft Edge extension that turns Microsoft 365 SharePoint and OneDrive for Business links into the folder location they point at.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
