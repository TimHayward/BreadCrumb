{
  "manifest_version": 3,
  "name": "BreadCrumb",
  "version": "0.2.0",
  "description": "Turns SharePoint and OneDrive citations in Copilot responses into folder locations and sends them to BreadCrumb.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "BreadCrumb"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://m365.cloud.microsoft/*",
        "https://copilot.cloud.microsoft/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://m365.cloud.microsoft/*",
    "https://copilot.cloud.microsoft/*",
    "https://copilot.microsoft.com/*"
  ],
  "permissions": ["storage", "activeTab", "clipboardWrite"]
}
