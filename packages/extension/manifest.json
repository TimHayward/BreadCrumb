{
  "manifest_version": 3,
  "name": "BreadCrumb",
  "version": "0.3.2",
  "description": "Turns SharePoint and OneDrive citations in Copilot responses into folder locations you can copy.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "BreadCrumb",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://m365.cloud.microsoft/*",
        "https://copilot.cloud.microsoft/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://m365.cloud.microsoft/*",
    "https://copilot.cloud.microsoft/*",
    "https://copilot.microsoft.com/*"
  ],
  "optional_host_permissions": [
    "https://*.sharepoint.com/*"
  ],
  "permissions": [
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
