{
  "manifest_version": 3,
  "name": "BreadCrumb",
  "version": "0.1.0",
  "description": "Turns SharePoint and OneDrive citations in Copilot responses into folder locations.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "BreadCrumb"
  },
  "host_permissions": [
    "https://m365.cloud.microsoft/*",
    "https://copilot.cloud.microsoft/*",
    "https://copilot.microsoft.com/*"
  ]
}
